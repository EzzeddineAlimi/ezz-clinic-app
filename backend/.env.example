# EZZ Clinic v0.2 backend — example configuration. FICTIONAL DATA ONLY. Copy to .env (git-ignored); never commit secrets.
# API connection: least-privilege role (ezz_app). Loopback/Unix socket may run without TLS (local dev/CI only).
# Any other host REQUIRES verified TLS, e.g. ...@db.example.invalid:5432/ezz?sslmode=verify-full&sslrootcert=/path/ca.pem
# (disable/prefer/require are refused for remote hosts). Optional: statement_timeout=<ms>, idle_in_transaction_session_timeout=<ms>.
DATABASE_URL=postgres://ezz_app:CHANGE_ME@localhost:5432/ezz_dev
# Migrations / seed: schema-owner role (ezz_owner). Never give this to the running API.
MIGRATION_DATABASE_URL=postgres://ezz_owner:CHANGE_ME@localhost:5432/ezz_dev
PORT=4180
BIND_HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API (empty = none; same-origin non-browser clients only).
ALLOWED_ORIGINS=
# Extra Host header values allowed besides 127.0.0.1/localhost (DNS-rebinding guard).
ALLOWED_HOSTS=
LOG_LEVEL=info
# Tests: superuser URL used ONLY to create/drop throw-away test databases.
EZZ_TEST_ADMIN_URL=postgres://postgres@localhost:5432/postgres?host=/tmp
