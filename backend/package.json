{
  "name": "ezz-clinic-backend",
  "version": "0.2.0-fictional",
  "private": true,
  "description": "EZZ Clinic v0.2 financial-integrity backend. FICTIONAL / SYNTHETIC DATA ONLY. Not for clinical use.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "lint": "biome lint .",
    "lint:verify": "node scripts/verify-lint-gate.ts",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "migrate": "node scripts/migrate.ts",
    "seed:fictional": "node scripts/seed-fictional.ts",
    "start": "node dist/src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts",
    "test:dist": "npm run build && node --test --test-concurrency=1 --test-timeout=60000 dist/test/*.test.js",
    "gen:openapi": "node scripts/gen-openapi.ts",
    "bench": "node scripts/bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
