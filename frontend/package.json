    "lint:verify": "node scripts/verify-lint-gate.mjs",
    "format:check": "biome format ."
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "6.0.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  }
}
